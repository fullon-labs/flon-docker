agent-name = FullOn testnet BP node
http-server-address = http-category-address
http-category-address = chain_ro,0.0.0.0:8888
http-category-address = chain_rw,127.0.0.1:8892
http-category-address = net_ro,127.0.0.1:8893
http-category-address = net_rw,127.0.0.1:8889
http-category-address = producer_ro,127.0.0.1:8894
http-category-address = producer_rw,127.0.0.1:8890
http-validate-host = true
verbose-http-errors = false
abi-serializer-max-time-ms = 1000
chain-state-db-size-mb = 32768
plugin = eosio::chain_plugin
plugin = eosio::chain_api_plugin
plugin = eosio::http_plugin
plugin = eosio::net_plugin
plugin = eosio::net_api_plugin
plugin = eosio::producer_plugin
plugin = eosio::producer_api_plugin
enable-stale-production = false
producer-name = REPLACE_TESTNET_PRODUCER_NAME
signature-provider = REPLACE_TESTNET_PUBLIC_KEY=KEY:REPLACE_TESTNET_PRIVATE_KEY
