def notifyTelegram(String channel, String reference, String chatId) {
    def message = """flon-core ${channel}: ${currentBuild.currentResult}
Ref: ${reference ?: 'unspecified'}
Build: ${env.JOB_NAME} #${env.BUILD_NUMBER}"""

    catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS',
               message: 'Telegram notification failed') {
        // Queue cancellation can reach post actions before the build agent has a workspace.
        timeout(time: 1, unit: 'MINUTES') {
            node('master') {
                withCredentials([string(credentialsId: 'tgbot', variable: 'TG_BOT')]) {
                    withEnv(["TELEGRAM_CHAT_ID=${chatId}", "TELEGRAM_MESSAGE=${message}"]) {
                        sh(label: 'Notify Telegram', script: '''
                            set +x
                            telegram_text=$(python3 -c '
from html import escape
import os

message = escape(os.environ["TELEGRAM_MESSAGE"])
console_url = escape(os.environ["BUILD_URL"].rstrip("/") + "/console", quote=True)
number = escape(os.environ["BUILD_NUMBER"])
print(message + "\\n查看：<a href=\\"%s\\">构建日志#%s</a>" % (console_url, number))
') || exit $?
                            response=$(printf 'url = "%s"\\n' "$TG_BOT" |
                                curl --config - --silent --show-error --fail --max-time 15 \\
                                    --data-urlencode "chat_id=$TELEGRAM_CHAT_ID" \\
                                    --data-urlencode "parse_mode=HTML" \\
                                    --data-urlencode "text=$telegram_text") || exit $?
                            printf '%s' "$response" | python3 -c '
import json, os, sys
reply = json.load(sys.stdin)
message = reply.get("result", {})
if not reply.get("ok") or str(message.get("chat", {}).get("id")) != os.environ["TELEGRAM_CHAT_ID"] or not message.get("message_id"):
    sys.exit("Telegram did not confirm delivery to the expected chat")
print("Telegram confirmed delivery, message ID", message["message_id"])
'
                        ''')
                    }
                }
            }
        }
    }
}

pipeline {
    agent {
        label 'a3'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timestamps()
        timeout(time: 240, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'RELEASE_TAG',
            defaultValue: '',
            description: 'Existing flon-core release tag to build and publish (for example: v0.6.6)',
            trim: true
        )
        string(
            name: 'BUILD_JOBS',
            defaultValue: '8',
            description: 'Parallel Make jobs for both node packages',
            trim: true
        )
    }

    environment {
        FLON_LOAD_USER_ENV = 'false'
        MODE = 'git'
        NODE_IMG_HEADER = 'ghcr.io/fullon-labs/'
        REPO = 'https://github.com/fullon-labs/flon-core.git'
    }

    stages {
        stage('Checkout build tools') {
            steps {
                git branch: 'main', url: 'https://github.com/fullon-labs/flon-docker.git'
            }
        }

        stage('Validate release tag') {
            steps {
                script {
                    def releaseTag = params.RELEASE_TAG?.trim()

                    if (!releaseTag || !(releaseTag ==~ /v?[0-9]+\.[0-9]+\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?/)) {
                        error("Invalid RELEASE_TAG: ${releaseTag}. Expected a tag such as v0.6.6 or v0.6.6-rc.1")
                    }

                    def buildJobs = params.BUILD_JOBS?.trim() ?: '8'
                    if (!(buildJobs ==~ /[1-9][0-9]*/) || !buildJobs.isInteger()) {
                        error('BUILD_JOBS must be a positive integer')
                    }

                    env.BUILD_JOBS = buildJobs
                    env.FULLON_BRANCH = releaseTag
                    env.FULLON_VERSION = releaseTag
                    env.CORE_IMAGE = "${env.NODE_IMG_HEADER}floncore/flon-node:${releaseTag}"
                    env.HISTORY_IMAGE = "${env.NODE_IMG_HEADER}floncore/flon-node-history:${releaseTag}"
                    currentBuild.description = "${releaseTag} -> flon-node + flon-node-history"
                }

                sh '''
                    set -eu
                    git ls-remote --exit-code --tags "${REPO}" "refs/tags/${FULLON_BRANCH}" >/dev/null
                    echo "Verified release tag: ${FULLON_BRANCH}"
                    echo "Core image: ${CORE_IMAGE}"
                    echo "History image: ${HISTORY_IMAGE}"
                '''
            }
        }

        stage('Validate publish credentials') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ghcr-fullon-labs',
                        usernameVariable: 'GHCR_USERNAME',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        test -n "${GHCR_USERNAME}"
                        test -n "${GHCR_TOKEN}"
                        echo 'GHCR publish credentials are available.'
                    '''
                }
            }
        }

        stage('Compile core node release') {
            steps {
                dir('flon.chain/node-build') {
                    sh '''
                        set -eu
                        mkdir -p "${WORKSPACE}/.jenkins-home"
                        DOCKER_IMG=floncore/flon-node FLON_NODE_VARIANT=core \
                          EXPORT_DEB=true HOME="${WORKSPACE}/.jenkins-home" ./build.sh
                        docker image inspect "${CORE_IMAGE}" >/dev/null
                    '''
                }
            }
        }

        stage('Compile history node release') {
            steps {
                dir('flon.chain/node-build') {
                    sh '''
                        set -eu
                        DOCKER_IMG=floncore/flon-node-history FLON_NODE_VARIANT=history \
                          EXPORT_DEB=true HOME="${WORKSPACE}/.jenkins-home" ./build.sh
                        docker image inspect "${HISTORY_IMAGE}" >/dev/null
                    '''
                }
            }
        }

        stage('Archive Debian package') {
            steps {
                archiveArtifacts artifacts: 'flon.chain/node-build/flon-node*_amd64.deb', fingerprint: true, onlyIfSuccessful: true
            }
        }

        stage('Publish tagged image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ghcr-fullon-labs',
                        usernameVariable: 'GHCR_USERNAME',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
                        printf '%s' "${GHCR_TOKEN}" | docker login ghcr.io --username "${GHCR_USERNAME}" --password-stdin
                        trap 'docker logout ghcr.io >/dev/null 2>&1 || true' EXIT
                        docker push "${CORE_IMAGE}"
                        docker push "${HISTORY_IMAGE}"
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                notifyTelegram('production release', params.RELEASE_TAG, '-4166428888')
            }
        }
        success {
            echo "Release completed: ${env.CORE_IMAGE} and ${env.HISTORY_IMAGE}"
        }
        failure {
            echo 'Release failed. Check tag validation, compilation, archived package, and registry publishing logs.'
        }
    }
}
